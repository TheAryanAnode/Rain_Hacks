# =============================================================================
# .env.example — copy into .env.local (the file Next.js reads).
#
# For localhost demo: leave Clerk as placeholders. App runs in DEMO MODE with
# mock travel data — no API keys required to view the UI.
# =============================================================================

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database — optional in demo mode
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth (Clerk) — placeholders keep DEMO MODE on
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app"

# LLMs — optional (planner has offline skeleton)
# Google AI Studio / Gemini — uses gemini-3.1-flash-lite (cheap free tier)
GOOGLE_GENERATIVE_AI_API_KEY=""

TAVILY_API_KEY=""
STAY22_API_KEY=""
STAY22_AID=""
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
# Optional — defaults to Rachel voice for TTS outcome demo
ELEVENLABS_VOICE_ID=""
MAPBOX_ACCESS_TOKEN=""
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
OPENWEATHER_API_KEY=""
VIATOR_API_KEY=""
ROVE_API_KEY=""
EXCHANGE_RATE_API_KEY=""
